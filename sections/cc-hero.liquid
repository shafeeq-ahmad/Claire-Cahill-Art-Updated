{%- liquid
  assign img = section.settings.image
  assign pictured = section.settings.pictured_product
  if img == blank and pictured != blank
    assign img = pictured.featured_media.preview_image
  endif
  assign alt = img.alt | default: section.settings.caption | default: section.settings.heading
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} cc-section cc-hero"
  style="--cc-pad-top: {{ section.settings.padding_top }}px; --cc-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="cc-hero__grid">
    <div class="cc-hero__text">
      <h1 class="cc-heading cc-heading--xl cc-hero__name">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="cc-lede">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="cc-actions">
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="cc-link" href="{{ section.settings.link_url | default: '#' }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <figure class="cc-hero__art">
      <span class="cc-mat{% if section.settings.contain %} cc-mat--contain{% endif %}" style="--cc-ratio: {{ section.settings.ratio }};">
        {%- if img != blank -%}
          {{
            img
            | image_url: width: 2000
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 990px) 58vw, 100vw',
              widths: '600, 900, 1200, 1600, 2000',
              alt: alt
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        {%- endif -%}
      </span>
      {%- if section.settings.caption != blank -%}
        <figcaption class="cc-label cc-hero__caption">
          {%- if pictured != blank -%}
            <a class="cc-label__meta cc-hero__caption-link" href="{{ pictured.url }}">{{ section.settings.caption | escape }}</a>
          {%- else -%}
            <span class="cc-label__meta">{{ section.settings.caption | escape }}</span>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>
  </div>
</div>

{% stylesheet %}
  .cc-hero__grid {
    display: grid;
    gap: var(--cc-space-4);
  }

  .cc-hero__text {
    display: grid;
    gap: var(--cc-space-3);
    align-content: end;
  }

  .cc-hero__name {
    max-width: 9ch;
  }

  .cc-hero__art {
    margin: 0;
  }

  .cc-hero__art .cc-mat {
    max-height: 82vh;
    margin-inline-start: auto;
  }

  .cc-hero__caption {
    justify-items: end;
  }

  .cc-hero__caption-link {
    color: var(--cc-label);
    text-decoration: none;
  }

  .cc-hero__caption-link:hover {
    color: var(--cc-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 990px) {
    .cc-hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--cc-space-5);
      align-items: end;
    }

    .cc-hero__text {
      padding-bottom: var(--cc-space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist hero",
  "class": "cc-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Claire Cahill"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Original paintings, fine art prints and keepsakes, made by hand in acrylic and oil.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View the gallery"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "Meet the artist"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    },
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the main photo of the pictured product."
    },
    {
      "type": "product",
      "id": "pictured_product",
      "label": "Pictured product",
      "info": "Optional. The caption links to this piece."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Like a wall label: title and medium.",
      "default": "Pictured: original acrylic painting"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "5 / 4", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "contain",
      "label": "Show the whole image (no cropping)",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Artist hero"
    }
  ]
}
{% endschema %}
