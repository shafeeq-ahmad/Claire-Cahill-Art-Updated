{%- liquid
  assign img = section.settings.image
  assign alt = img.alt | default: section.settings.caption | default: section.settings.heading
  assign has_image = false
  if img != blank
    assign has_image = true
  endif
  assign heading_tag = 'h2'
  if section.settings.is_page_title
    assign heading_tag = 'h1'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} cc-section cc-feature cc-feature--{{ section.settings.image_side }} cc-feature--{{ section.settings.image_size }}{% unless has_image %} cc-feature--text-only{% endunless %}"
  style="--cc-pad-top: {{ section.settings.padding_top }}px; --cc-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="cc-feature__grid">
    {%- if has_image -%}
      <figure class="cc-feature__media">
        <span class="cc-mat{% if section.settings.contain %} cc-mat--contain{% endif %}" style="--cc-ratio: {{ section.settings.ratio }};">
          {{
            img
            | image_url: width: 1600
            | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1100, 1600', alt: alt
          }}
        </span>
        {%- if section.settings.caption != blank -%}
          <figcaption class="cc-label"><span class="cc-label__meta">{{ section.settings.caption | escape }}</span></figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="cc-feature__text">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="cc-heading {% if section.settings.is_page_title %}cc-heading--xl{% else %}cc-heading--l{% endif %}">
          {{- section.settings.heading | escape -}}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cc-prose">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <div class="cc-actions">
          {%- if section.settings.link_style == 'button' -%}
            <a class="button" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label | escape }}</a>
          {%- else -%}
            <a class="cc-link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .cc-feature__grid {
    display: grid;
    gap: var(--cc-space-4);
    align-items: center;
  }

  .cc-feature__media {
    margin: 0;
  }

  .cc-feature__text {
    display: grid;
    gap: var(--cc-space-3);
    align-content: center;
  }

  @media screen and (min-width: 990px) {
    .cc-feature--large .cc-feature__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--cc-space-6); }
    .cc-feature--medium .cc-feature__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--cc-space-6); }
    .cc-feature--small .cc-feature__grid { grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); gap: var(--cc-space-5); }

    .cc-feature--right.cc-feature--large .cc-feature__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
    .cc-feature--right.cc-feature--medium .cc-feature__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .cc-feature--right.cc-feature--small .cc-feature__grid { grid-template-columns: minmax(0, 8fr) minmax(0, 3fr); }

    .cc-feature--right .cc-feature__media { order: 2; }
  }

  .cc-feature--text-only .cc-feature__grid {
    grid-template-columns: minmax(0, 1fr);
    max-width: 44rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "info": "Optional, like a wall label."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "5 / 4", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "contain",
      "label": "Show the whole image (no cropping)",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the studio"
    },
    {
      "type": "checkbox",
      "id": "is_page_title",
      "label": "Use as the page title",
      "info": "Turn on for the first section of a page only.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell the story behind this work.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Link style",
      "options": [
        { "value": "link", "label": "Text link" },
        { "value": "button", "label": "Button" }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Image with story"
    }
  ]
}
{% endschema %}
