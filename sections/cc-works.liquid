{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign limit = section.settings.limit
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} cc-section cc-works"
  style="--cc-pad-top: {{ section.settings.padding_top }}px; --cc-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div>
    <div class="cc-section-head">
      <h2 class="cc-heading cc-heading--l">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="cc-link" href="{{ source.url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if source.products_count > 0 -%}
      <ul class="cc-grid cc-works__grid" style="--cc-cols: {{ section.settings.columns }};" role="list">
        {%- for product in source.products limit: limit -%}
          <li>
            {%- render 'cc-piece',
              product: product,
              ratio: section.settings.ratio,
              contain: section.settings.contain
            -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="cc-section-head__note">This collection has no products yet.</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cc-works__grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Selected works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New in the studio"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show pieces from the whole store."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See every piece"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pieces to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Pieces per row on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "contain",
      "label": "Show whole images (no cropping)",
      "info": "Best when product photos have mixed shapes.",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Selected works"
    }
  ]
}
{% endschema %}
