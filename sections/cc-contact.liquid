{%- liquid
  assign topics = section.settings.topics | newline_to_br | split: '<br />'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} cc-section cc-contact"
  style="--cc-pad-top: {{ section.settings.padding_top }}px; --cc-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="cc-contact__grid">
    <div class="cc-contact__intro">
      <h1 class="cc-heading cc-heading--xl">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="cc-prose">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.details != blank -%}
        <div class="cc-prose cc-contact__details">{{ section.settings.details }}</div>
      {%- endif -%}
    </div>

    <div class="cc-contact__form">
      {%- form 'contact', id: 'ContactForm', class: 'cc-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="cc-form__status cc-form__status--ok" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_message | escape }}
          </p>
        {%- elsif form.errors -%}
          <div class="cc-form__status cc-form__status--error" role="alert" tabindex="-1" autofocus>
            <p>Please check the highlighted fields:</p>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="cc-field">
          <label class="cc-field__label" for="ContactForm-name">Your name</label>
          <input class="cc-field__input" id="ContactForm-name" type="text" name="contact[Name]" autocomplete="name" value="{{ form.name }}">
        </div>

        <div class="cc-field">
          <label class="cc-field__label" for="ContactForm-email">Email <span class="cc-field__req">(required)</span></label>
          <input
            class="cc-field__input"
            id="ContactForm-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            required
            value="{% if form.email != blank %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
        </div>

        <div class="cc-field">
          <label class="cc-field__label" for="ContactForm-phone">Phone <span class="cc-field__opt">(optional)</span></label>
          <input class="cc-field__input" id="ContactForm-phone" type="tel" name="contact[Phone]" autocomplete="tel" value="{{ form.phone }}">
        </div>

        {%- if topics.size > 0 and section.settings.topics != blank -%}
          <div class="cc-field">
            <label class="cc-field__label" for="ContactForm-topic">What is this about?</label>
            <select class="cc-field__input" id="ContactForm-topic" name="contact[Topic]">
              {%- for topic in topics -%}
                {%- assign t = topic | strip -%}
                {%- if t != blank -%}<option value="{{ t | escape }}">{{ t | escape }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="cc-field">
          <label class="cc-field__label" for="ContactForm-body">Message <span class="cc-field__req">(required)</span></label>
          <textarea class="cc-field__input cc-field__input--area" id="ContactForm-body" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="button cc-form__submit">{{ section.settings.button_label | escape }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .cc-contact__grid {
    display: grid;
    gap: var(--cc-space-5);
  }

  .cc-contact__intro {
    display: grid;
    gap: var(--cc-space-3);
    align-content: start;
  }

  .cc-contact__details {
    padding-top: var(--cc-space-3);
    border-top: 1px solid var(--cc-rule);
    color: var(--cc-label);
  }

  .cc-contact__details a { color: var(--cc-navy); }

  @media screen and (min-width: 990px) {
    .cc-contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--cc-space-6);
    }
  }

  .cc-form {
    display: grid;
    gap: var(--cc-space-3);
    max-width: 36rem;
  }

  .cc-field {
    display: grid;
    gap: 0.4rem;
  }

  .cc-field__label {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--cc-ink);
  }

  .cc-field__req,
  .cc-field__opt {
    font-weight: 400;
    color: var(--cc-label);
  }

  .cc-field__input {
    font: inherit;
    font-size: 1rem;
    color: var(--cc-ink);
    background: var(--cc-paper);
    border: 1px solid #c9c5bf;
    border-radius: 2px;
    padding: 0.8rem 0.9rem;
    width: 100%;
  }

  .cc-field__input:focus-visible {
    outline: 2px solid var(--cc-navy);
    outline-offset: 1px;
    border-color: var(--cc-navy);
  }

  .cc-field__input[aria-invalid='true'] {
    border-color: #a3342b;
  }

  .cc-field__input--area {
    resize: vertical;
    min-height: 10rem;
  }

  .cc-form__submit {
    justify-self: start;
    min-width: 12rem;
  }

  .cc-form__status {
    margin: 0;
    padding: var(--cc-space-2) var(--cc-space-3);
    border-left: 3px solid var(--cc-navy);
    background: var(--cc-wall);
  }

  .cc-form__status--error { border-left-color: #a3342b; }
  .cc-form__status ul { margin: 0.5rem 0 0; padding-left: 1.1rem; }
  .cc-form__status p { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Ask about an original, a commission, or an order. Messages come straight to Claire.</p>"
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Other ways to reach Claire",
      "info": "Optional: email, studio location, social links."
    },
    {
      "type": "textarea",
      "id": "topics",
      "label": "Topics",
      "info": "One per line. Leave empty to hide the topic menu.",
      "default": "A question about a painting\nCommissioning a piece\nAn order I placed\nSomething else"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message after sending",
      "default": "Thank you. Your message is on its way to Claire."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
